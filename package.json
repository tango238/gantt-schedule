{
  "name": "schedule",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker-test.json",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "db:migrate:local": "wrangler d1 migrations apply schedule --local",
    "db:migrate:remote": "wrangler d1 migrations apply schedule --remote",
    "deploy": "pnpm build && wrangler deploy",
    "gen:types": "json2ts -i schema/gantt.schema.json -o src/shared/model/schema.d.ts",
    "gen:validator": "node scripts/gen-validator.mjs",
    "cf-typegen": "wrangler types worker-runtime.d.ts --include-env=false"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "immer": "^11.2.9",
    "jose": "^6.2.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^31.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
